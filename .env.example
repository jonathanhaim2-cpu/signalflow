SECRET_KEY=change-this-to-a-random-secret-in-production
DATABASE_URL=sqlite+aiosqlite:///./signalflow.db
TELEGRAM_DEFAULT_BOT_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
# Optional. If empty, the public webhook URL is taken from the incoming request host.
APP_BASE_URL=
# Comma-separated emails that should be treated as Pro (no payment).
ALLOW_PRO_EMAILS=
# Owner admin emails. jonathanhaim2@gmail.com is always owner (admin+pro on first login).
ADMIN_EMAILS=jonathanhaim2@gmail.com
# Paddle Billing (USD). Create a product + $9/month price in the Paddle dashboard.
# Never commit live secrets.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
PADDLE_SANDBOX=true
